# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Groq (free tier available): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default model
# GROQ_MODEL=llama-3.3-70b-versatile

# ── MCP data sources ──────────────────────────────────────────────────────────
# Tavily web search (free tier): https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack (free tier): https://aviationstack.com
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeatherMap (free tier): https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# LangGraph uses this for persistent thread memory (checkpoints)
# Local: postgresql://postgres:password@localhost:5432/langgraph_memory_demo
# VPS:   postgresql://postgres:PASSWORD@localhost:5432/langgraph_memory_demo
DATABASE_URL=postgresql://postgres:password@localhost:5432/langgraph_memory_demo

# ── Optional overrides ────────────────────────────────────────────────────────
# Only needed if the aviationstack-mcp repo lives outside the project folder.
# Default (Windows): ./aviationstack-mcp/.venv/Scripts/python.exe
# Default (Linux):   ./aviationstack-mcp/.venv/bin/python
# AVIATION_MCP_PYTHON=/custom/path/to/.venv/bin/python
